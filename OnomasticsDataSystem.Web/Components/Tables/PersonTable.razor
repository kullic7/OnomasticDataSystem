@using OnomasticsDataSystem.Core.Entity
@inject NavigationManager Navigation
<div class="table-container">

    <table class="person-table">

        <thead class="table-header">
            <tr>
                <th class="select-col">
                    
                </th>

                <th class="col-id">Id</th>
                <th>Meno</th>
                <th>Priezvisko</th>
                <th>Mesto narodenia</th>
                <th>Rok narodenia</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var person in Persons)
            {
                <tr class="table-row"
                    @onclick="() => ToggleRow(person)">

                    <td class="select-col">
                        <input type="checkbox"
                               class="big-checkbox"
                               checked="@SelectedPersons.Contains(person)"
                               @onclick:stopPropagation="true"
                               @onchange="(e => TogglePerson(person, (bool)e.Value))" />
                    </td>

                    <td>@person.Id</td>
                    
                    <td>
                        <span class="name-link"
                              @onclick="() => NavigateToName(person.FirstNameNormalized)">
                            @person.FirstName
                            <span class="stat-icon">📊</span>
                        </span>
                    </td>
                    <td>
                        <span class="name-link"
                              @onclick="() => NavigateToSurname(person.LastNameNormalized)">
                            @person.LastName
                            <span class="stat-icon">📊</span>
                        </span>
                    </td>
                    <td>
                        <span class="name-link"
                              @onclick="() => NavigateToCity(person.BirthCityNormalized)">
                            @person.BirthCity
                            <span class="stat-icon">📊</span>
                        </span>
                    </td>
                    
                    <td>@person.BirthYear</td>

                </tr>
            }
        </tbody>

    </table>

</div>

@code {


    [Parameter]
    public List<Person> SelectedPersons { get; set; } = new();
    [Parameter]
    public List<Person> Persons { get; set; } = new();
    [Parameter] public EventCallback OnSelectionChanged { get; set; }
    async Task TogglePerson(Person person, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedPersons.Contains(person))
                SelectedPersons.Add(person);
        }
        else
        {
            SelectedPersons.Remove(person);
        }
        await OnSelectionChanged.InvokeAsync();
    }
    async Task ToggleRow(Person person)
    {
        if (SelectedPersons.Contains(person))
            SelectedPersons.Remove(person);
        else
            SelectedPersons.Add(person);
        await OnSelectionChanged.InvokeAsync();
    }
    void NavigateToName(string name)
    {
        Navigation.NavigateTo($"/mena?name={name}");
    }
    void NavigateToSurname(string name)
    {
        Navigation.NavigateTo($"/priezviska?surname={name}");
    }
    void NavigateToCity(string name)
    {
        Navigation.NavigateTo($"/miesta?city={name}");
    }
}