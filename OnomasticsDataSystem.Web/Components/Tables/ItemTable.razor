@using OnomasticsDataSystem.Core.Entity
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="table-container">
    <table class="person-table">
        <thead class="table-header">
            <tr>
                @if (Mode == "person")
                {
                    <th class="select-col"></th>
                }

                <th class="col-id">Id</th>

                @if (Mode == "person")
                {                 
                    <th>Meno</th>
                    <th>Priezvisko</th>
                    <th>Mesto narodenia</th>
                    <th>Rok narodenia</th>
                    <th>Zdroj</th>
                }
                else
                {
                    <th>Názov</th>
                    <th>Počet</th>

                    @if (ShowLength)
                    {
                        <th>Dĺžka</th>
                    }

                    @if (ShowSyllables)
                    {
                        <th>Slabiky</th>
                    }

                    @if (ShowPercentage)
                    {
                        <th>% dát</th>
                    }
                }
            </tr>
        </thead>

        <tbody>
            @if (Mode == "person")
            {
                @foreach (var person in Persons)
                {
                    <tr class="table-row" @onclick="() => ToggleRow(person)">

                        <td class="select-col">
                            <input type="checkbox"
                                   class="big-checkbox"
                                   checked="@SelectedPersons.Contains(person)"
                                   @onclick:stopPropagation="true"
                                   @onchange="(e => TogglePerson(person, (bool)e.Value))" />
                        </td>

                        <td>@person.Id</td>

                        <td>
                            <span class="name-link"
                                  @onclick="() => NavigateToName(person.FirstNameNormalized)">
                                @person.FirstName
                                <span class="stat-icon">📊</span>
                            </span>
                        </td>

                        <td>
                            <span class="name-link"
                                  @onclick="() => NavigateToSurname(person.LastNameNormalized)">
                                @person.LastName
                                <span class="stat-icon">📊</span>
                            </span>
                        </td>

                        <td>
                            <span class="name-link"
                                  @onclick="() => NavigateToCity(person.BirthCityNormalized)">
                                @person.BirthCity
                                <span class="stat-icon">📊</span>
                            </span>
                        </td>

                        <td>@person.BirthYear</td>
                        <td>@(person.Source?.Name ?? "-")</td>
                    </tr>
                }
            }
            else
            {
                @for (int i = 0; i < Items.Count; i++)
                {
                    var it = Items[i];

                    <tr class="table-row">
                        <td>@((Page - 1) * PageSize + i + 1)</td>

                        <td>
                            <span class="name-link"
                                  @onclick="() => ItemClicked(it.Name)">
                                @it.Name
                                <span class="stat-icon">📊</span>
                            </span>

                        </td>

                        <td>@it.Count</td>

                        @if (ShowLength)
                        {
                            <td>@it.Length</td>
                        }

                        @if (ShowSyllables)
                        {
                            <td>@it.Syllables</td>
                        }

                        @if (ShowPercentage)
                        {
                            <td>@GetPercentage(it.Count)</td>
                        }
                    </tr>
                }
            }
        </tbody>

    </table>

</div>

@code {
    [Parameter] public string Mode { get; set; } = "stats"; // stats | person
    [Parameter] public string Type { get; set; } = "name"; // name | surname
    [Parameter] public List<ItemStats> Items { get; set; } = new(); // pre stats mode
    [Parameter] public List<Person> Persons { get; set; } = new(); // pre person mode

    [Parameter] public List<Person> SelectedPersons { get; set; } = new(); // only for person mode
    [Parameter] public EventCallback OnSelectionChanged { get; set; } // only for person mode
    [Parameter] public bool ShowPercentage { get; set; } = true; // only for stats mode
    [Parameter] public bool ShowLength { get; set; } = false; // only for stats mode
    [Parameter] public bool ShowSyllables { get; set; } = false; // only for stats mode
    
    [Parameter] public EventCallback<string> OnNameSelected { get; set; } // only for stats mode

    [Parameter] public int Page { get; set; }

    [Parameter] public int PageSize { get; set; }

    int totalCount => Items.Sum(x => x.Count);

    string GetPercentage(int count)
    {
        if (totalCount == 0)
            return "0%";

        double percent = (double)count / totalCount * 100;
        return percent.ToString("0.00") + "%";
    }
    async Task ItemClicked(string name)
    {
        if (OnNameSelected.HasDelegate)
        {
            await OnNameSelected.InvokeAsync(name);
        }
        else
        {
            if (Type == "surname")
                Navigation.NavigateTo($"/priezviska?surname={name}");
            else
                Navigation.NavigateTo($"/mena?name={name}");
        }

        await JS.InvokeVoidAsync("scrollToChart");
    }
    async Task TogglePerson(Person person, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedPersons.Contains(person))
                SelectedPersons.Add(person);
        }
        else
        {
            SelectedPersons.Remove(person);
        }

        await OnSelectionChanged.InvokeAsync();
    }

    async Task ToggleRow(Person person)
    {
        if (SelectedPersons.Contains(person))
            SelectedPersons.Remove(person);
        else
            SelectedPersons.Add(person);

        await OnSelectionChanged.InvokeAsync();
    }
    void NavigateToName(string name)
    {
        Navigation.NavigateTo($"/mena?name={name}");
    }

    void NavigateToSurname(string name)
    {
        Navigation.NavigateTo($"/priezviska?surname={name}");
    }

    void NavigateToCity(string name)
    {
        Navigation.NavigateTo($"/miesta?city={name}");
    }
}