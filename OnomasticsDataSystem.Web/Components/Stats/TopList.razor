<MudPaper Class="pa-4"
          Style="background:linear-gradient(180deg,#ffffff,#f1f5f9);">

    <MudText Typo="Typo.h6"
             Align="Align.Center"
             Style="font-weight:700; margin-bottom:16px;">
        @Title
    </MudText>

    @foreach (var item in Items)
    {
        <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">

            <MudText Style="width:24px; font-weight:700;">@item.Rank</MudText>

            <MudProgressLinear Value="@item.Percent"
                               Color="@BarColor"
                               Rounded="true"
                               Class="top-progress"
                               Style="height:28px; flex:1" >

                <MudText Class="ml-2">@item.Name</MudText>

            </MudProgressLinear>

            <MudText Class="ml-2" Style="font-weight:700;">
                @item.Value
            </MudText>

        </MudStack>
    }

</MudPaper>

@code {

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public List<TopItem> Items { get; set; } = new();
    [Parameter] public Color BarColor { get; set; } = Color.Primary;

}